  "narrative": {
    "donts": [
      "**Don't** 恢复分类筛选、固定 6/9/12 行容量、自动双列或按时间重新布局。",
      "**Don't** 以随机重排、浓重纹理、大圆角或硬阴影取代纸张材料。",
      "**Don't** 让相片归属依赖署名，或用未标注的演示留言制造可信度。",
      "**Don't** 将纸面裁切误写成自动增高或承诺无限图片容量。"
    ],
    "northStar": "午后窗边",
    "dos": [
      "**Do** 延续原纸纹、四纸色、宋体、胶带和柔影。",
      "**Do** 保持已发布坐标与相对位置，手机通过镜头探索同一空间。",
      "**Do** 用文字、形状与颜色共同说明选中、可贴、无效和错误状态。",
      "**Do** 保留清楚焦点、原生链接行为、移动柄键盘操作与固定下一步。",
      "**Do** 准确区分无限坐标空间和当前整墙数据加载的规模限制。"
    ],
    "keyCharacteristics": [
      "暖米纸纹与四种纸色，纸面和墙面共享材料语言。",
      "宋体承担留言与名称，无衬线承担操作与辅助说明。",
      "轻胶带、不对称小圆角、柔和纸影保留手作感。",
      "自由坐标跨设备保持，桌面两栏编辑器在手机改为上下结构。",
      "几何 SVG、清楚焦点、文字和颜色共同表达操作状态。"
    ],
    "overview": "暖米纸纹、低饱和纸色、宋体、轻胶带与柔影延续「暖阳治愈系 · 自然简约 · 轻手作感」。这一轮替换墙的空间与编辑交互，保留既有品牌世界；不生成或替换新位图素材。\n\n纸张自由占据二维空间，空间关系来自访客确认的位置。界面控件安静、直接：墙上读与探索，编辑器里清楚操作，放置阶段用纸张预览和可建造区反馈位置。",
    "rules": [
      {
        "body": "纸色表达材料，控件与辅助文字保持清楚对比；四纸色不重新绑定分类。",
        "section": "colors",
        "name": "The Paper and Ink Rule"
      },
      {
        "body": "宋体留给名称与留言，无衬线负责操作和辅助信息。",
        "section": "typography",
        "name": "The Two Voices Rule"
      },
      {
        "body": "阴影表达材料离墙的细微距离，保留柔边与扩散。",
        "section": "elevation",
        "name": "The Soft Paper Rule"
      },
      {
        "body": "纸张的手作感来自纸材、胶带与访客放置；刷新不重抽倾角或错位，不把 ID 随机姿态再叠加到碰撞几何上。",
        "section": "elevation",
        "name": "The Saved Position Rule"
      },
      {
        "name": "The World Light Rule",
        "body": "日光投影固定在二维墙面坐标，与便签共用世界变换；提前绘制分块，拖动时不异步追赶，视口尺寸不改变图案。",
        "section": "elevation"
      }
    ]
  }
